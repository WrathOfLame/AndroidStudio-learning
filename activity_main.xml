<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tekstNazwa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tekstKwota"
            app:layout_constraintHorizontal_chainStyle="packed" />

        <TextView
            android:id="@+id/tekstKategoria"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tekstNazwa"
            app:layout_constraintTop_toBottomOf="@id/tekstNazwa"
            app:layout_constraintEnd_toEndOf="@id/tekstNazwa" />

        <TextView
            android:id="@+id/tekstKwota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="@id/tekstNazwa"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/przyciskUsun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuń"
            app:layout_constraintTop_toBottomOf="@id/tekstKwota"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
